# Environment variables for Personal Weight Tracker
# Copy this file to .env and fill in your values

# Application Settings
APP_ENV=development  # development, production, or testing
DEBUG=True

# Logging Settings
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=app.log

# Optional: API Keys (if needed in the future)
# OPENAI_API_KEY=your_api_key_here
# LANGCHAIN_API_KEY=your_api_key_here

# Optional: Database Settings (if needed in the future)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=weight_tracker
# DB_USER=your_username
# DB_PASSWORD=your_password
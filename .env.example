# Environment variables for Personal Weight Tracker
# Copy this file to .env and fill in your values

# Application Settings
APP_ENV=development  # development, production, or testing
DEBUG=True

# Logging Settings
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=app.log

# Supabase Settings (for cloud database)
USE_SUPABASE=False  # Set to True to use Supabase instead of CSV
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Optional: API Keys (if needed in the future)
# OPENAI_API_KEY=your_api_key_here
# LANGCHAIN_API_KEY=your_api_key_here